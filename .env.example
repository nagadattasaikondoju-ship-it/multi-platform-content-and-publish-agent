# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides
GROW_IT_BRIEF_MODEL=gemini-flash-latest
GROW_IT_POST_MODEL=gemini-flash-latest
# Tried in turn when the main model is overloaded or rate-limited
GROW_IT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
# Publishing (only needed for `grow-it publish --live`). Zernio is used when its key is set.
# Zernio: sign up at zernio.com, connect your social accounts, copy the API key
ZERNIO_API_KEY=
# Ayrshare (alternative)
AYRSHARE_API_KEY=
# Video generation for `grow-it video` (only needed for --live). Get both
# from the API tab in your TopView account settings.
TOPVIEW_API_KEY=
TOPVIEW_UID=
# Public mode: Auth0 (callback <base url>/auth/callback) ...
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# ... or Google directly (redirect URI <base url>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROW_IT_SECRET=
GROW_IT_BASE_URL=
GROW_IT_ADMIN_EMAILS=
GROW_IT_DAILY_LOOP_LIMIT=20
