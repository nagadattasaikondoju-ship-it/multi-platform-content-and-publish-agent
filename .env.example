# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides
GROW_IT_BRIEF_MODEL=gemini-flash-latest
GROW_IT_POST_MODEL=gemini-flash-latest
# Tried in turn when the main model is overloaded or rate-limited
GROW_IT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
# Publishing (only needed for `grow-it publish --live`). Zernio is used when its key is set.
# Zernio: sign up at zernio.com, connect your social accounts, copy the API key
ZERNIO_API_KEY=
# Ayrshare (alternative)
AYRSHARE_API_KEY=
